# ==============================================================================
# FreelanceHub Environment Variables Configuration
# Copy this to .env for local testing, or add these to your Vercel Project Settings:
# Settings -> Environment Variables
# ==============================================================================

# Node Environment
NODE_ENV=production

# MongoDB Atlas Database Connection URI
# Replace with your actual MongoDB Atlas cluster connection string:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/freelancehub?retryWrites=true&w=majority

# JWT Authentication Secret & Expiration
JWT_SECRET=freelancehub_super_secret_jwt_key_2025_academic
JWT_EXPIRE=7d

# Razorpay Payment Gateway (Test Mode or Live Mode)
# Keep these strictly on backend environment variables
RAZORPAY_KEY_ID=rzp_test_FreelanceHubDemoKey
RAZORPAY_KEY_SECRET=rzp_test_FreelanceHubDemoSecret

# Platform Settings
DEFAULT_PLATFORM_COMMISSION=10

# Local Port (Used only during local 'npm run dev' or 'npm start')
PORT=5000
